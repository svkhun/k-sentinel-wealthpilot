<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" fill="none">
  <defs>
    <linearGradient id="shield-grad" x1="4" y1="2" x2="28" y2="30" gradientUnits="userSpaceOnUse">
      <stop stop-color="#006837" />
      <stop offset="0.5" stop-color="#00A950" />
      <stop offset="1" stop-color="#22C55E" />
    </linearGradient>
    <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="2" stdDeviation="2" flood-color="#00A950" flood-opacity="0.4" />
    </filter>
  </defs>
  
  <!-- Rounded Shield Base -->
  <path d="M16 2.5L5 6.5V14.5C5 21.8 10 27.8 16 29.5C22 27.8 27 21.8 27 14.5V6.5L16 2.5Z" 
        fill="url(#shield-grad)" 
        stroke="#86EFAC" 
        stroke-width="1.5" 
        stroke-linejoin="round"
        filter="url(#glow)" />
        
  <!-- White Security Checkmark -->
  <path d="M11 15L14.5 18.5L21.5 11" 
        stroke="#FFFFFF" 
        stroke-width="2.5" 
        stroke-linecap="round" 
        stroke-linejoin="round" />
        
  <!-- Emerald Pulse Center -->
  <circle cx="16" cy="24" r="1.5" fill="#DCFCE7" />
</svg>
